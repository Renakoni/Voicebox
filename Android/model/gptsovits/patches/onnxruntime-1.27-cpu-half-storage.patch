+// Experimental opt-in: exact half storage, FP32 arithmetic. Pack N in blocks
+// of 16 and retain MLAS's 256-element K reduction boundaries and FMA order.
+static bool PackExactHalfWeights(const Tensor& tensor, bool transpose, AllocatorPtr alloc,
+                                 IAllocatorUniquePtr<void>& packed) {
+  const auto& shape = tensor.Shape();
+  if (shape.NumDimensions() != 2) return false;
+  const size_t k = static_cast<size_t>(shape[transpose ? 1 : 0]);
+  const size_t n = static_cast<size_t>(shape[transpose ? 0 : 1]);
+  if (n == 0 || n % 16 != 0 || k == 0 || tensor.Shape().Size() < 32768) return false;
+  packed = IAllocator::MakeUniquePtr<void>(alloc, SafeInt<size_t>(tensor.Shape().Size()) * sizeof(MLFloat16), true);
+  auto* destination = static_cast<MLFloat16*>(packed.get());
+  const auto* source = tensor.Data<float>();
+  for (size_t column = 0; column < n; column += 16) {
+    for (size_t inner = 0; inner < k; ++inner) {
+      for (size_t lane = 0; lane < 16; ++lane) {
+        const float value = source[transpose ? (column + lane) * k + inner : inner * n + column + lane];
+        const MLFloat16 half(value);
+        if (!std::isfinite(value) || half.ToFloat() != value) {
+          packed.reset();
+          return false;
+        }
+        *destination++ = half;
+      }
+    }
+  }
+  return true;
+}
+
+static void ComputeExactHalfWeights(const float* a, const MLFloat16* b, float* y,
+                                    const MatMulComputeHelper& helper, float alpha,
+                                    concurrency::ThreadPool* thread_pool) {
+  const size_t m = helper.M(), n = helper.N(), k = helper.K();
+  const size_t blocks = n / 16;
+  const size_t tasks = helper.OutputOffsets().size() * m * blocks;
+  concurrency::ThreadPool::TryParallelFor(
+      thread_pool, static_cast<ptrdiff_t>(tasks),
+      {static_cast<double>(k * 16 * sizeof(MLFloat16)), 16 * sizeof(float), static_cast<double>(k * 32)},
+      [&](ptrdiff_t begin, ptrdiff_t end) {
+        for (size_t task = static_cast<size_t>(begin); task < static_cast<size_t>(end); ++task) {
+          const size_t block = task % blocks;
+          const size_t row = task / blocks % m;
+          const size_t batch = task / blocks / m;
+          const float* input = a + helper.LeftOffsets()[batch] + row * k;
+          float* output = y + helper.OutputOffsets()[batch] + row * n + block * 16;
+          const auto* weights = reinterpret_cast<const float16_t*>(b + block * k * 16);
+          for (size_t base = 0; base < k; base += 256) {
+            float32x4_t s0 = vdupq_n_f32(0), s1 = s0, s2 = s0, s3 = s0;
+            const size_t limit = std::min(k, base + 256);
+            for (size_t inner = base; inner < limit; ++inner) {
+              const float16x8_t w0 = vld1q_f16(weights + inner * 16);
+              const float16x8_t w1 = vld1q_f16(weights + inner * 16 + 8);
+              const float value = input[inner];
+              s0 = vfmaq_n_f32(s0, vcvt_f32_f16(vget_low_f16(w0)), value);
+              s1 = vfmaq_n_f32(s1, vcvt_high_f32_f16(w0), value);
+              s2 = vfmaq_n_f32(s2, vcvt_f32_f16(vget_low_f16(w1)), value);
+              s3 = vfmaq_n_f32(s3, vcvt_high_f32_f16(w1), value);
+            }
+            if (base == 0) {
+              vst1q_f32(output, vmulq_n_f32(s0, alpha));
+              vst1q_f32(output + 4, vmulq_n_f32(s1, alpha));
+              vst1q_f32(output + 8, vmulq_n_f32(s2, alpha));
+              vst1q_f32(output + 12, vmulq_n_f32(s3, alpha));
+            } else {
+              vst1q_f32(output, vfmaq_n_f32(vld1q_f32(output), s0, alpha));
+              vst1q_f32(output + 4, vfmaq_n_f32(vld1q_f32(output + 4), s1, alpha));
+              vst1q_f32(output + 8, vfmaq_n_f32(vld1q_f32(output + 8), s2, alpha));
+              vst1q_f32(output + 12, vfmaq_n_f32(vld1q_f32(output + 12), s3, alpha));
+            }
+          }
+        }
+      });
+}

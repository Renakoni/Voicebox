 }
+
+#ifdef GGML_USE_HEXAGON
+extern "C" JNIEXPORT jboolean JNICALL
+Java_dev_renakoni_voicebox_model_qwen3_QwenDevices_probe(JNIEnv *, jclass, jboolean htp) {
+    try {
+        if (htp) {
+            auto reg = ggml_backend_hexagon_reg();
+            if (!reg || !ggml_backend_reg_dev_count(reg)) return false;
+            ggml_backend_register(reg);
+        }
+        auto backend = ggml_backend_init_by_name(htp ? "HTP0" : "Vulkan0", nullptr);
+        if (!backend) return false;
+        ggml_backend_free(backend);
+        return true;
+    } catch (const std::exception &e) {
+        __android_log_write(ANDROID_LOG_WARN, "QwenWorker", e.what());
+        return false;
+    }
+}
+#endif

@@ -6,6 +6,9 @@
 
 #include <android/log.h>
 #include <jni.h>
+#ifdef GGML_USE_HEXAGON
+#include "ggml-hexagon.h"
+#endif
 
 #include <atomic>
 #include <cstdlib>
